.add-btn {
  background: #1677ff;
  color: #fff;
  text-align: center;
  line-height: 80rpx;
  border-radius: 12rpx;
  margin: 20rpx;
}
.stock-banner {
  margin: 20rpx;
  padding: 24rpx 24rpx 20rpx;
  background: #ffffff;
  border-radius: 18rpx;
  border: 1rpx solid #f0f0f0;
}
.stock-title {
  color: #333;
  font-size: 28rpx;
  margin-bottom: 16rpx;
}
.stock-value {
  color: #fa541c;
  font-size: 42rpx;
  font-weight: bold;
  margin-bottom: 10rpx;
}
.stock-sub {
  color: #999;
  font-size: 24rpx;
}
.summary-banner {
  width: 80%;
  margin: 20rpx;
  padding: 24rpx 24rpx;
  background: #fff;
  border-radius: 18rpx;
  border: 1rpx solid #f0f0f0;
}
.summary-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}
.summary-row:last-child {
  border-bottom: none;
}
.summary-label {
  color: #666;
  font-size: 26rpx;
  flex: 1;
  text-align: left;
}
.summary-value {
  color: #333;
  font-size: 26rpx;
  font-weight: bold;
  flex: 1;
  text-align: right;
}
.profit {
  color: #ff4d4f;
}
.loss {
  color: #52c41a;
}
.market-row .summary-value {
  color: #333;
}
.item {
  padding: 20rpx;
  margin: 20rpx;
  background: #fff;
  border-radius: 12rpx;
}

/* 弹窗样式 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.5);
  display: flex;
  align-items: center;
  justify-content: center;
}
.modal {
  width: 80%;
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
}
.title {
  text-align: center;
  font-size: 32rpx;
  margin-bottom: 30rpx;
}
input {
  border: 1px solid #eee;
  padding: 20rpx;
  margin: 15rpx 0;
  border-radius: 8rpx;
}
.btn-wrap {
  display: flex;
  justify-content: space-between;
  margin-top: 30rpx;
}