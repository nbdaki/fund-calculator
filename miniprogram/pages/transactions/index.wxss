.filter-row {
  padding: 20rpx;
}
.selector {
  width: 100%;
  border: 1px solid #eee;
  border-radius: 12rpx;
  padding: 18rpx 20rpx;
  font-size: 28rpx;
  color: #333;
  background: #fff;
}
.add-btn {
  display: block;
  width: calc(100% - 40rpx);
  margin: 0 20rpx 20rpx;
  background: #1677ff;
  color: #fff;
  text-align: center;
  line-height: 80rpx;
  border-radius: 12rpx;
  border: none;
}
.add-btn[disabled] {
  background: #c0c4cc;
  color: #fff;
}
.table-wrap {
  margin: 20rpx;
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  border: 1rpx solid #e8e8e8;
}
.table-header,
.table-row {
  display: flex;
  align-items: center;
  padding: 18rpx 20rpx;
}
.table-header {
  background: #f5f7fa;
  font-weight: bold;
}
.table-row {
  border-top: 1rpx solid #f0f0f0;
}
.cell {
  flex: 1;
  color: #333;
  font-size: 26rpx;
}
.cell-date {
  flex: 1.2;
}
.cell-price,
.cell-count,
.cell-fee,
.cell-total {
  flex: 1;
  text-align: right;
}
.empty-tip {
  padding: 30rpx 20rpx;
  color: #999;
  text-align: center;
}
.hint-text {
  font-size: 9px;
  font-style: italic;
}

/* 弹窗样式 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.5);
  display: flex;
  align-items: center;
  justify-content: center;
}
.modal {
  width: 84%;
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
}
.title {
  text-align: center;
  font-size: 32rpx;
  margin-bottom: 30rpx;
}
input,
.picker-row {
  border: 1px solid #eee;
  padding: 20rpx;
  margin: 15rpx 0;
  border-radius: 8rpx;
  font-size: 28rpx;
}
.picker-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.picker-value {
  color: #666;
}
.btn-wrap {
  display: flex;
  justify-content: space-between;
  margin-top: 30rpx;
}
.btn-wrap button {
  width: 45%;
}
